# =========================================================================
# FACEID & eKYC MICROSERVICE CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền thông tin khi triển khai server
# =========================================================================

# --- 1. SERVER CONFIG ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=false

# --- 2. POSTGRESQL DATABASE ---
DB_URL=postgresql://<DB_HOST>:5432/<DB_NAME>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintech_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# --- 3. CLOUDINARY MEDIA STORAGE (LƯU TRỮ 5 ẢNH eKYC) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- 4. BIOMETRIC THRESHOLDS ---
FACE_MATCH_THRESHOLD=0.40
LIVENESS_THRESHOLD=0.50
